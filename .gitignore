# ==============================================================================
# Stock Market Distribution Analyzer - .gitignore
# ==============================================================================

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Caches and test logs
.cache/
.pytest_cache/
*.log

# Environment configuration (preserve .env.example)
.env
.env.*
!.env.example

# Local staging / workspace directories excluded from repo root
dist/
Stock_Return_AI_Lab/
presentation_extraction/

# Legacy Streamlit directory
.streamlit/

# Operating system and editor artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
