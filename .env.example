# ==============================================================================
# Stock Market Distribution Analyzer - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as required.
# DO NOT commit real API keys or credentials to version control.

# Local Server Settings
LAB_HOST=127.0.0.1
LAB_PORT=5000
LAB_DEBUG=False
SECRET_KEY=dev-secret-key-change-in-production

# External Data & Network Settings
DOWNLOAD_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=3600

# Optional OpenAI Integration
# The application functions 100% offline using deterministic rule-based engines
# if this key is omitted or left as default.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
